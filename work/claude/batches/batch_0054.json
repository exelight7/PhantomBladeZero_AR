[
 {
  "key": "QuestRumorDes_020_02",
  "text": "إحضار نصل موجي الملطخ بالدماء إلى ليو يي"
 },
 {
  "key": "QuestRumorDes_020_03",
  "text": "انتزاع سيف موجي"
 },
 {
  "key": "QuestRumorDes_021_01",
  "text": "العثور على سجل السائر المقنّع المعذّب"
 },
 {
  "key": "QuestRumorDes_021_02",
  "text": "إعادة السجل إلى السائر المقنّع المعذّب"
 },
 {
  "key": "QuestRumorDes_024_01",
  "text": "ما السر الكامن في فناء الخان المغلق بالسلاسل؟"
 },
 {
  "key": "QuestRumorDes_024_02",
  "text": "التحقيق في فناء الخان المغلق بالسلاسل"
 },
 {
  "key": "QuestRumorDes_024_03",
  "text": "كشف حقيقة تحوّل تلاميذ الميثاق إلى سائرين مقنّعين"
 },
 {
  "key": "QuestRumorDes_024_04",
  "text": "تسليم أمر القائد إلى نائبه عند أطراف برج شا-تشي"
 },
 {
  "key": "QuestRumorDes_024_05",
  "text": "إظهار أدلة جرائم غو لينغران للقائد"
 },
 {
  "key": "QuestRumorDes_024_S1",
  "text": "مواجهة القائد بشأن الارتقاء المشتبه به"
 },
 {
  "key": "QuestRumorDes_025_01",
  "text": "القضاء على تلاميذ الرامي العجوز الفاسدين في معسكر الرامي القاسي"
 },
 {
  "key": "QuestRumorDes_025_02",
  "text": "تسليم قوس الريش ذي الوتر المقطوع إلى الرامي العجوز في الخان"
 },
 {
  "key": "QuestRumorDes_026_01",
  "text": "العثور على الأعشاب الثلاث الواردة في وصفة يوأر الطبية في وادي الجدول الباكي."
 },
 {
  "key": "QuestRumorDes_026_02",
  "text": "إحضار الأعشاب الثلاث إلى يوأر."
 },
 {
  "key": "QuestRumorDes_027_01",
  "text": "التوجه إلى الموقع المحدد في سجل اللصوص المفقودين ومعالجة جراحهم"
 },
 {
  "key": "QuestRumorDes_027_02",
  "text": "إبلاغ يوأر بالعثور على اللصوص ومعالجة جراحهم"
 },
 {
  "key": "QuestRumorDes_028_01",
  "text": "إيصال رسالة دمية المغنية إلى بَي"
 },
 {
  "key": "QuestRumorDes_028_02",
  "text": "هل ستجد دمية المغنية وبَي نهاية سعيدة يومًا ما؟"
 },
 {
  "key": "QuestRumorDes_028_03",
  "text": "العثور على جثة بَي"
 },
 {
  "key": "QuestRumorDes_028_04",
  "text": "إخبار دمية المغنية بمصير بَي"
 },
 {
  "key": "QuestRumorDes_029_01",
  "text": "إيصال رسالة اللص الرشيق المكتوبة بالدم إلى أخيه، اللص الوديع"
 },
 {
  "key": "QuestRumorDes_030_01",
  "text": "العثور على جوهر البرونز في دكان الحداد بالزقاق الخلفي في بانغتشن"
 },
 {
  "key": "QuestRumorDes_030_02",
  "text": "صقل الروح لسيف تيانشيوان البرونزي باستخدام جوهر البرونز"
 },
 {
  "key": "QuestRumorDes_030_03",
  "text": "التحدث مع الطاوي بيدي في حانة التنظيم"
 },
 {
  "key": "QuestRumorDes_031_01",
  "text": "العثور على رفيقي الصياد المفقودين في بحيرة ميغو"
 },
 {
  "key": "QuestRumorDes_031_02",
  "text": "العودة إلى الحانة وإخبار الصياد بما حلّ برفيقيه"
 },
 {
  "key": "QuestRumorDes_031_03",
  "text": "التحدث إلى ضبابة لمعرفة المزيد عن المكعّب"
 },
 {
  "key": "QuestRumorDes_032_01",
  "text": "لقاء قائد تشكيل النجوم السبعة، ثم التحدث مع قائد الذئب في حانة التنظيم"
