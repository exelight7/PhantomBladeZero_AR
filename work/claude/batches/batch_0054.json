 {
  "key": "QuestRumor_SubTitle_027",
  "text": "يدا المعالج أمانة مقدسة"
 },
 {
  "key": "QuestRumor_SubTitle_028",
  "text": "متى نلتقي مجددًا؟"
 },
 {
  "key": "QuestRumor_SubTitle_029",
  "text": "أُخذ ليلًا، وأُعيد عند الفجر"
