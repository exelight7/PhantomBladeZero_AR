 {
  "key": "UI_Setting_373",
  "text": "إعداد وحدة التحكّم المسبق 3"
 },
 {
  "key": "UI_Setting_374",
  "text": "جودة الدقّة الديناميكية"
 },
 {
  "key": "UI_Setting_375",
  "text": "خفض ديناميكي لجودة الدقّة الفائقة عندما يقل معدل الإطارات الأساسي، قبل توليد الإطارات، عن <Character_Yellow_Decorator2>معدل الإطارات المستهدف</>. عند تفعيل حدّ لمعدل الإطارات أو المزامنة الرأسية، لا تسري هذه الميزة إلا عندما يبلغ معدل الإطارات الأساسي <Character_Yellow_Decorator2>معدل الإطارات المستهدف</>. تفعيل هذا الخيار لثبات أكبر لمعدل الإطارات."
 },
 {
  "key": "UI_Setting_376",
  "text": "الإجراء"
 },
 {
  "key": "UI_Setting_377",
  "text": "لوحة المفاتيح والفأرة\n(أساسي)"
 },
 {
  "key": "UI_Setting_378",
  "text": "لوحة المفاتيح والفأرة\n(ثانوي)"
 },
 {
  "key": "UI_Setting_379",
  "text": "وحدة التحكّم"
 },
 {
  "key": "UI_Setting_380",
  "text": "لا تتوفر الدقّة الديناميكية عند تفعيل إعادة بناء الأشعة بتقنية DLSS."
 },
 {
  "key": "UI_Setting_381",
  "text": "لا تتوفر جودة الدقّة الديناميكية عند تفعيل إعادة بناء الأشعة بتقنية DLSS."
 },
 {
  "key": "UI_Setting_382",
  "text": "يتطلّب توليد الإطارات جدولة معالج الرسوميات المسرَّع عتاديًّا. الانتقال إلى إعدادات ويندوز > النظام > العرض > الرسومات > تغيير إعدادات الرسومات الافتراضية، ثم تفعيل جدولة معالج الرسوميات المسرَّع عتاديًّا وإعادة تشغيل الحاسوب."
 },
 {
  "key": "UI_Setting_383",
  "text": "اختيار إعداد مسبق لتخطيط أزرار وحدة التحكّم اللاسلكية."
 },
 {
  "key": "UI_Setting_384",
  "text": "ضبط جودة الدقّة الفائقة بتقنية DLSS. يحسّن وضع الجودة جودة الصورة، بينما يزيد وضع الأداء معدل الإطارات. يعرض DLAA الصورة بالدقّة الأصلية للحصول على أفضل جودة للصورة."
 },
 {
  "key": "UI_Setting_385",
  "text": "عرض تخطيط لوحة المفاتيح والفأرة المخصّص 1 وتعديله."
 },
 {
  "key": "UI_Setting_386",
  "text": "عرض تخطيط لوحة المفاتيح والفأرة المخصّص 2 وتعديله."
 },
 {
  "key": "UI_Setting_387",
  "text": "إنهاء اللعبة الحالية والعودة إلى شاشة البداية."
 },
 {
  "key": "UI_Setting_388",
  "text": "إغلاق اللعبة والعودة إلى سطح المكتب."
 },
 {
  "key": "UI_Setting_389",
  "text": "تفعيل إنفيديا Reflex لخفض زمن استجابة النظام. في الوضع التلقائي، يتفعّل عند تفعيل توليد الإطارات بتقنية DLSS أو المزامنة الرأسية. يتطلّب معالج رسوميات من إنفيديا متوافقًا."
 },
 {
  "key": "UI_Setting_390",
  "text": "ضبط دقّة العرض الداخلية التي يستخدمها FSR."
 },
 {
  "key": "UI_Setting_391",
  "text": "سماعات الرأس: تحسين الصوت لسماعات الرأس المجسّمة."
 },
 {
  "key": "UI_Setting_392",
  "text": "تتبّع المسارات"
 },
 {
  "key": "UI_Setting_393",
  "text": "بطاقة الرسوميات أو برنامج التشغيل الحالي غير متوافق مع تتبّع الأشعة."
 },
 {
  "key": "UI_Setting_394",
  "text": "تعيين مستوى جودة تتبّع الأشعة. يجعل تفعيل تتبّع الأشعة الانعكاسات والظلال والإضاءة الشاملة أكثر واقعية على حساب الأداء. يوفّر تتبّع المسارات أعلى جودة للصورة، لكنه يفرض العبء الأكبر على معالج الرسوميات."
 },
 {
  "key": "UI_Setting_395",
  "text": "اهتزاز الحركة"
 },
 {
  "key": "UI_Setting_396",
  "text": "مستوى صوت مكبّر وحدة التحكّم"
 },
 {
  "key": "UI_Setting_397",
  "text": "ضبط مستوى صوت مكبّر وحدة التحكّم."
 }
