 {
  "key": "UI_Setting_355",
  "text": "إعادة بناء الأشعة"
 },
 {
  "key": "UI_Setting_356",
  "text": "تفعيل إعادة بناء الأشعة بتقنية DLSS من إنفيديا، التي تستبدل مزيلات التشويش التقليدية لتتبّع الأشعة بإزالة التشويش بالذكاء الاصطناعي لتحسين وضوح الصور المتتبّعة بالأشعة وثباتها. يتطلب ذلك تتبّع الأشعة والدقّة الفائقة بتقنية DLSS."
 },
 {
  "key": "UI_Setting_357",
  "text": "متاح عند تفعيل تتبّع الأشعة."
 },
 {
  "key": "UI_Setting_358",
  "text": "تحرير"
 },
 {
  "key": "UI_Setting_359",
  "text": "لا يمكن تغيير تتبّع الأشعة إلا من شاشة البداية."
 },
