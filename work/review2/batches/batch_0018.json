 },
 {
  "key": "QuestCollect_SubTitle_008",
  "text": "يهبط الليل وتخفت طبول الحرب"
 },
 {
  "key": "QuestCollectDes_008_01",
  "text": "جمع زهور الذكرى الخاصة بالمعلّم الأكبر لرقصة الأسد."
 },
 {
