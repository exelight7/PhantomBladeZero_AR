 },
 {
  "key": "QuestCollectDes_003_05",
  "text": "جمع جميع الكنوز في بحيرة ميغو."
 },
 {
  "key": "QuestCollectDes_003_09",
  "text": "تسليم جميع كنوز بحيرة ميغو إلى تشانغ سريع اليد."
 },
 {
  "key": "QuestCollectDes_003_06",
  "text": "جمع جميع الكنوز في ضيعة السراب."
 },
 {
  "key": "QuestCollectDes_003_10",
  "text": "تسليم جميع كنوز ضيعة السراب إلى تشانغ سريع اليد."
 },
 {
  "key": "QuestCollect_004",
  "text": "قلب شجرة التين البنغالي"
 },
 {
  "key": "QuestCollect_SubTitle_004",
  "text": "أبخرة الدم والأغصان الملتوية"
 },
 {
  "key": "QuestCollectDes_004_01",
  "text": "العثور على أشجار البانيان ذات الوجه البشري"
 },
 {
  "key": "QuestCollect_005",
  "text": "تشكيل النجوم السبعة"
 },
 {
  "key": "QuestCollect_SubTitle_005",
  "text": "معًا عبر النار والماء"
 },
 {
  "key": "QuestCollectDes_005_01",
  "text": "جمع زهور الذكرى لتلاميذ النجوم السبعة."
 },
 {
  "key": "QuestCollect_006",
  "text": "أوتار رنّانة"
 },
 {
  "key": "QuestCollect_SubTitle_006",
  "text": "عودة لحن مألوف"
 },
 {
  "key": "QuestCollectDes_006_01",
  "text": "جمع زهور الذكرى الخاصة بإنانيس والوتر."
 },
 {
  "key": "QuestCollect_007",
  "text": "الظل الأبيض"
 },
 {
  "key": "QuestCollect_SubTitle_007",
  "text": "في طلب الأهل وسط الريح والثلج"
 },
 {
  "key": "QuestCollectDes_007_01",
  "text": "جمع زهور الذكرى الخاصة بسيّد النصل في العاصفة الثلجية."
 },
 {
