[
 {
  "key": "QuestRumor_SubTitle_026",
  "text": "هنا يبدأ درب الشفاء"
 },
 {
  "key": "QuestRumorDes_026_01",
  "text": "العثور على الأعشاب الثلاث الواردة في وصفة يوأر الطبية في وادي الجدول الباكي."
 },
 {
  "key": "QuestRumorDes_026_02",
  "text": "إحضار الأعشاب الثلاث إلى يوأر."
 },
 {
  "key": "QuestRumor_027",
  "text": "رحمة المعالج"
 },
 {
  "key": "QuestRumor_SubTitle_027",
  "text": "يدا المعالج أمانة مقدسة"
 },
 {
  "key": "QuestRumorDes_027_01",
  "text": "التوجه إلى الموقع المحدد في سجل اللصوص المفقودين ومعالجة جراحهم"
 },
 {
  "key": "QuestRumorDes_027_02",
  "text": "إبلاغ يوأر بالعثور على اللصوص ومعالجة جراحهم"
 },
 {
  "key": "QuestRumor_028",
  "text": "قلب الدمية الخشبي"
 },
 {
  "key": "QuestRumor_SubTitle_028",
  "text": "متى نلتقي مجددًا؟"
 },
 {
  "key": "QuestRumorDes_028_01",
  "text": "إيصال رسالة دمية المغنية إلى بَي"
 },
 {
  "key": "QuestRumorDes_028_02",
  "text": "هل ستجد دمية المغنية وبَي نهاية سعيدة يومًا ما؟"
 },
 {
  "key": "QuestRumorDes_028_03",
  "text": "العثور على جثة بَي"
 },
 {
  "key": "QuestRumorDes_028_04",
  "text": "إخبار دمية المغنية بمصير بَي"
 },
 {
  "key": "QuestRumor_029",
  "text": "الشرف بين اللصوص"
 },
 {
  "key": "QuestRumor_SubTitle_029",
  "text": "أُخذ ليلًا، وأُعيد عند الفجر"
 },
 {
  "key": "QuestRumorDes_029_01",
  "text": "إيصال رسالة اللص الرشيق المكتوبة بالدم إلى أخيه، اللص الوديع"
 },
 {
  "key": "QuestRumor_030",
  "text": "السيف والطريق"
 },
 {
  "key": "QuestRumor_SubTitle_030",
  "text": "العالم الفاني درب التزكية"
 },
 {
  "key": "QuestRumorDes_030_01",
  "text": "العثور على جوهر البرونز في دكان الحداد بالزقاق الخلفي في بانغتشن"
 },
 {
  "key": "QuestRumorDes_030_02",
  "text": "صقل الروح لسيف تيانشيوان البرونزي باستخدام جوهر البرونز"
 },
 {
  "key": "QuestRumorDes_030_03",
  "text": "التحدث مع الطاوي بيدي في حانة التنظيم"
 },
 {
  "key": "QuestRumor_031",
  "text": "المكعّب"
 },
 {
  "key": "QuestRumor_SubTitle_031",
  "text": "غرض ليس من هذا العالم"
 },
 {
  "key": "QuestRumorDes_031_01",
  "text": "العثور على رفيقي الصياد المفقودين في بحيرة ميغو"
 },
 {
  "key": "QuestRumorDes_031_02",
  "text": "العودة إلى الحانة وإخبار الصياد بما حلّ برفيقيه"
 },
 {
  "key": "QuestRumorDes_031_03",
  "text": "التحدث إلى ضبابة لمعرفة المزيد عن المكعّب"
 },
 {
  "key": "QuestRumor_032",
  "text": "الروح البطولية الخالدة"
 },
 {
  "key": "QuestRumor_SubTitle_032",
  "text": "إن سقطت السماء نهضت، وإن تصدّعت الأرض ثبتُّ"
 },
 {
  "key": "QuestRumorDes_032_01",
  "text": "لقاء قائد تشكيل النجوم السبعة، ثم التحدث مع قائد الذئب في حانة التنظيم"
 },
 {
  "key": "QuestRumorDes_032_02",
  "text": "تحرير أساتذة الميثاق المكابدين وإجلال روحهم الخالدة"
 },
 {
  "key": "QuestRumor_033",
  "text": "نجمة المسرح"
 },
 {
  "key": "QuestRumor_SubTitle_033",
  "text": "من يذكر الحرير القرمزي على خشبة المسرح؟"
 },
 {
  "key": "QuestRumorDes_033_01",
  "text": "استدراج بوّاب جناح تيانشيانغ في الزقاق المجاور لخشبة أوبرا بانغتشن"
 },
 {
  "key": "QuestRumorDes_033_02",
  "text": "دخول جناح تيانشيانغ"
 },
 {
  "key": "QuestRumorDes_033_03",
  "text": "العثور على مروحة الرقص الخاصة بنجم الأوبرا الأول"
 },
 {
  "key": "QuestRumorDes_033_04",
  "text": "إعادة المروحة إلى دمية المؤدية الرئيسية في الحانة"
 },
 {
  "key": "QuestRumor_034",
  "text": "لا تنسني"
 },
 {
  "key": "QuestRumor_SubTitle_034",
  "text": "الحياة أو الموت"
 },
 {
  "key": "QuestRumorDes_034_01",
  "text": "تواصل المرأة على سطح نُزُل بانغتشن التمتمة قائلة: «الأخ الأكبر تشو». تُرى، هل انتقلت روحها من جسدها؟"
 },
 {
  "key": "QuestRumorDes_034_02",
  "text": "إيصال رسالة تشو بينغتسي الأخيرة إلى امرأة تدعى يو لينغ في بانغتشن"
 },
 {
  "key": "QuestRumor_035",
  "text": "استخدامه ضدهم"
 },
 {
  "key": "QuestRumor_SubTitle_035",
  "text": "السلاح في اليد، واختباره"
 },
 {
  "key": "QuestRumorDes_035_01",
  "text": "مواجهة راقصة اليشم وشيطان الحديد باستخدام مناشير الشيطان سلاحًا أساسيًا، والقفازات الحديدية سلاحًا طيفيًا"
 },
 {
  "key": "QuestRumor_036",
  "text": "قلب القبضة"
 },
 {
  "key": "QuestRumor_SubTitle_036",
  "text": "عزيمة صقلها التمرّس لا تزال صامدة"
 },
 {
  "key": "QuestRumorDes_036_01",
  "text": "العثور على شاهد قبر سيد القبضة الحديدية في غابة المرايا المغطاة بالثلوج"
 },
 {
  "key": "QuestCollect_001",
  "text": "أعمدة لونغ"
 },
 {
  "key": "QuestCollect_SubTitle_001",
  "text": "إرساء السماء وختم الفساد"
 },
 {
  "key": "QuestCollectDes_001_01",
  "text": "العثور على أعمدة لونغ المخفية في أنحاء البلاد ولمسها."
 },
 {
  "key": "QuestCollect_002",
  "text": "أوكار الأرنب الماكر الثلاثة"
 },
 {
  "key": "QuestCollect_SubTitle_002",
  "text": "ألف درب بين الحقيقة والخداع"
 },
 {
  "key": "QuestCollectDes_002_01",
  "text": "العثور على كنز تشانغ سريع اليد المخفي في الغابة القرمزية."
 },
 {
  "key": "QuestCollectDes_002_02",
  "text": "العثور على مخابئ تشانغ سريع اليد الأخرى."
 },
 {
  "key": "QuestCollect_003",
  "text": "طلب تشانغ سريع اليد"
 },
 {
  "key": "QuestCollect_SubTitle_003",
  "text": "كنز خفي ينتظر"
 },
 {
  "key": "QuestCollectDes_003_01",
  "text": "جمع جميع الكنوز في الغابة القرمزية."
 },
 {
  "key": "QuestCollectDes_003_02",
  "text": "تسليم جميع كنوز الغابة القرمزية إلى تشانغ سريع اليد."
 },
 {
  "key": "QuestCollectDes_003_03",
  "text": "جمع جميع الكنوز في قرية لو."
 },
 {
  "key": "QuestCollectDes_003_07",
  "text": "تسليم جميع كنوز قرية لو إلى تشانغ سريع اليد."
 },
 {
  "key": "QuestCollectDes_003_04",
  "text": "جمع جميع الكنوز في بانغتشن."
 },
 {
  "key": "QuestCollectDes_003_08",
