[
 {
  "key": "Dlg_Music_ChiHeiDuanLong_21",
  "text": "تنعم الأمم كلها بالسلام"
 },
 {
  "key": "Dlg_Music_LongTiZuoShang_1",
  "text": "لقاء موفّق"
 },
 {
  "key": "Dlg_Music_MuXiaoKui_1",
  "text": "قارب وحيد يعلو ويهبط في رحلته"
 },
 {
  "key": "Dlg_Music_MuXiaoKui_2",
  "text": "التشبث ببقايا شعلة تحتضر"
 },
 {
  "key": "Dlg_Music_MuXiaoKui_3",
  "text": "إذا حُبستُ في حلم بعيد من زمن مضى"
 },
 {
  "key": "Dlg_Music_MuXiaoKui_4",
  "text": "فليمرّ بي إذن وينساب بعيدًا"
 },
 {
  "key": "Dlg_Music_MuXiaoKui_5",
  "text": "الإصغاء إلى الريح وهي تندفع بمحاذاة الأذنين"
 },
 {
  "key": "Dlg_Music_MuXiaoKui_6",
  "text": "إطفاء مصباح الذكرى"
 },
 {
  "key": "Dlg_Music_MuXiaoKui_6_1",
  "text": "حتى الجوهرة التي خبأتها في قلبي تآكلت مع الزمن"
 },
 {
  "key": "Dlg_Music_MuXiaoKui_6_2",
  "text": "إنه لون السماء الأصلي"
 },
 {
  "key": "Dlg_Music_MuXiaoKui_7",
  "text": "لا لا لا لا، لا لا لا..."
 },
 {
  "key": "Dlg_Music_MuXiaoKui_8",
  "text": "انجراف، انجراف في قلب بحيرة متلألئة"
 },
 {
  "key": "Dlg_Music_MuXiaoKui_8_1",
  "text": "تغيب الشمس الآفلة في قلب الأرض"
 },
 {
  "key": "Dlg_Music_MuXiaoKui_8_2",
  "text": "ترك الزهرة الضائعة وراءنا"
 },
 {
  "key": "Dlg_Music_MuXiaoKui_8_3",
  "text": "تعبر الجبال والأنهار وقد غطاها الثلج"
 },
 {
  "key": "Dlg_Music_MuXiaoKui_8_4",
  "text": "ونفترق في هذه اللحظة"
 },
 {
  "key": "Dlg_Music_MuXiaoKui_8_5",
  "text": "أفكّ رباط قلبي"
 },
 {
  "key": "Dlg_Music_MuXiaoKui_9",
  "text": "ودع الريح تحمل ذلك عبر عالم لا حدود له"
 },
 {
  "key": "Dlg_Music_MuXiaoKui_9_1",
  "text": "أعدك، على مرّ الفصول، فيما يزهر القصب ثم يذبل"
 },
 {
  "key": "Dlg_Music_MuXiaoKui_9_2",
  "text": "سنلتقي مجددًا في هذه اللحظة"
 },
 {
  "key": "Dlg_Music_MuXiaoKui_11",
  "text": "طفوٌ، طفوٌ في مدّ القلب المتلألئ"
 },
 {
  "key": "Dlg_Music_MuXiaoKui_12",
  "text": "يأبى القمر أن يغيب"
 },
 {
  "key": "Dlg_Music_MuXiaoKui_13",
  "text": "إلقاء ستر على هذا المكان"
 },
 {
  "key": "Dlg_Music_MuXiaoKui_14",
  "text": "لا شمس تلوح في الأفق"
 },
 {
  "key": "Dlg_Music_MuXiaoKui_15",
  "text": "ضللت الطريق"
 },
 {
  "key": "Dlg_Music_MuXiaoKui_16",
  "text": "كالدخان والسحب الهائمة"
 },
 {
  "key": "Dlg_Music_MuXiaoKui_17",
  "text": "تمضي مع الريح إلى البعيد"
 },
 {
  "key": "Dlg_Music_MuXiaoKui_18",
  "text": "هائمًا، عائمًا"
 },
 {
  "key": "Dlg_Music_MuXiaoKui_19",
  "text": "إلى أن نلتقي من جديد"
 },
 {
  "key": "QuestHint_01-DDSD_001",
