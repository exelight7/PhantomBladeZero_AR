[
 {
  "key": "Dlg_End_B_ZuoShang2_ZuoShang_2",
  "text": "لكنني أعرف من أكون وما أستطيع فعله!"
 },
 {
  "key": "Dlg_End_BAS_ZuoShang3_ZuoShang_1",
  "text": "من دون قوتك الحقيقية، لا تشكّل تهديدًا لي."
 },
 {
  "key": "Dlg_End_BAS_ZuoShang3_ZuoShang_2",
  "text": "استفد إلى أقصى حد مما بقي لك من وقت."
 },
 {
  "key": "Dlg_End_A_Subtitle_1",
  "text": "زئير لونغ"
 },
 {
  "key": "Dlg_End_B_Inanis1_Inanis_1",
  "text": "القلب المشعّ الآن في يد تسو شانغ. إن أردت النجاة، فعليك أن تجده في ما بقي لك من وقت..."
 },
 {
  "key": "Dlg_End_B_Inanis1_Inanis_2",
  "text": "وانتزعه منه!"
 },
 {
  "key": "Dlg_End_B_Inanis1_Hun_3",
  "text": "لم يعد الأمر مهمًا."
 },
 {
  "key": "Dlg_End_B_Inanis1_Hun_4",
  "text": "لم تُدخل السيدة الآفة إلى عالم اليقظة. وقد نجا كثيرون بفضل ذلك."
 },
 {
  "key": "Dlg_End_B_Inanis1_Inanis_5",
  "text": "ها... رؤيتك تمنعها أعادت إليّ ذكريات مواجهتي لها بنفسي."
 },
 {
  "key": "Dlg_End_B_Inanis1_Inanis_6",
  "text": "فقدان خصم جدير... يترك فراغًا لا يزول."
 },
 {
  "key": "Dlg_End_B_Inanis1_Hun_7",
  "text": "صنع تسو شانغ وعاءً لنفسه، ويستخدم القلب المشعّ ليمدّه بالطاقة."
 },
 {
  "key": "Dlg_End_B_Inanis1_Hun_8",
  "text": "لم يعد الجرح الذي أحدثته في قلبه مشكلةً له."
 },
 {
  "key": "Dlg_End_B_Inanis1_Hun_9",
  "text": "في قتالي معه، بدا وعاؤه شبه منيع. لا أحد يستطيع الوقوف في وجهه."
 },
 {
  "key": "Dlg_End_B_Inanis1_Inanis_10",
  "text": "مع أن ما بقي لك من وقت يتناقص... هل ستواصل المضي حتى لو سقطت هنا؟"
 },
 {
  "key": "Dlg_End_B_Inanis2_Hun_1",
  "text": "ما دام فيّ نفس، فلن أتوقف أبدًا."
 },
 {
  "key": "Dlg_End_ZuoShangLongTi_Battle_1",
  "text": "انتهى زمن الرحمة."
 },
 {
  "key": "Dlg_End_ZuoShangLongTi_Battle_2",
  "text": "ينتهي الآن صراع أجيال!"
 },
 {
  "key": "Dlg_End_ZuoShangLongTi_Battle_3",
  "text": "الآفة بكل أشكالها... طوع أمري!"
 },
 {
  "key": "Dlg_End_ZuoShangLongTi_Battle_4",
  "text": "لا أحد في هذا العالم يستطيع الوقوف في وجهي!"
 },
 {
  "key": "Dlg_End_ZuoShangLongTi_Battle_5",
  "text": "اهلك بنَفَس لونغ!"
 },
 {
  "key": "Dlg_End_ZuoShangLongTi_Battle_6",
  "text": "يسقط النظام القديم، ويبدأ عالم جديد!"
 },
 {
  "key": "Dlg_End_S_ShaoNian_ZuoShang_1",
  "text": "لقد تأخرت!"
 },
 {
  "key": "Dlg_End_S_ChengNian_ZuoShang_1",
  "text": "لقد تأخرت."
 },
 {
  "key": "Dlg_End_A_ShaoNian_MuTianMiao_1",
  "text": "في الوولين، يمضي الناس على غير هدى، كأعشاب الماء في مهبّ العاصفة. فمن يجد جذوره حقًا؟"
 },
 {
  "key": "Dlg_End_A_ShaoNian_ZuoShang_2",
  "text": "لكننا لم نأتِ من العدم."
 },
 {
  "key": "Dlg_End_A_ChengNian_ZuoShang_1",
  "text": "بالمناسبة... قبل أن يدخل شيفو في خلوته، ترك خريطة تحدد موقعًا. وأوصاني بأن أسلّمها إليك."
 },
 {
  "key": "Dlg_End_A_ChengNian_ZuoShang_2",
  "text": "ارتدى شيفو القناع ليكبح شا-تشي لديه. ولم يواجهك إلا بنحو 70 بالمئة من قوته الكاملة."
 },
 {
  "key": "Dlg_End_A_ChengNian_ZuoShang_3",
  "text": "ومع ذلك... فقتَ توقعاتي."
 },
 {
  "key": "Dlg_End_A_ZuoShang1_ZuoShang_1",
  "text": "أخيرًا... بدأت تدرك من تكون حقًا..."
 },
 {
  "key": "Dlg_End_A_ZuoShang1_ZuoShang_2",
  "text": "حصن مو... حسن. حسن جدًا..."
 },
 {
  "key": "Dlg_End_A_ZuoShang1_ZuoShang_3",
  "text": "لكنني لن أموت على يدك!"
 },
 {
  "key": "Dlg_End_A_Inanis2_Hun_1",
  "text": "لم تُدخل السيدة الآفة إلى عالم اليقظة. وقد نجا كثيرون بفضل ذلك."
 },
 {
  "key": "Dlg_End_A_Inanis2_Inanis_2",
  "text": "ها... رؤيتك توقفها أعادت إليّ ذكريات مواجهتي لها بنفسي."
 },
 {
  "key": "Dlg_End_A_Inanis2_Inanis_3",
  "text": "فقدان خصم جدير... يترك فراغًا لا يزول."
 },
 {
  "key": "Dlg_End_A_Inanis2_Inanis_4",
  "text": "القلب المشعّ الذي تحمله... هو مفتاح إنقاذ قلبك المعتلّ."
 },
 {
  "key": "Dlg_End_A_Inanis2_Inanis_5",
  "text": "إن قصدت نحّات اللحم... فبوسعه زرعه في صدرك ليحلّ محلّ قلبك التالف."
 },
 {
  "key": "Dlg_End_A_Inanis2_Inanis_6",
  "text": "لن تعيش عقودًا أخرى فحسب... بل ستغدو، بما تملكه من شا-تشي وبراعة قتالية، لا نظير لك في هذا العالم."
 },
 {
  "key": "Dlg_End_A_Inanis2_Inanis_7",
  "text": "ومع ذلك... يمكن عدّ هذا ضربًا من الارتقاء."
 },
 {
  "key": "Dlg_End_A_Inanis2_Hun_8",
  "text": "نعم. سبب لا يُقاوم للارتقاء."
 },
 {
  "key": "Dlg_End_A_Inanis2_Hun_9",
  "text": "لا يختلف عن الإغراء الذي واجهه أبطال الميثاق قديمًا..."
 },
 {
  "key": "Dlg_End_A_Inanis2_Hun_10",
  "text": "وجدت قلبي... فهل عليّ الآن أن أتخلى عنه؟"
 },
 {
  "key": "Dlg_End_S_Subtitle_1",
  "text": "المعركة الأخيرة"
 },
 {
  "key": "Dlg_End_A_Inanis3_Inanis_1",
  "text": "أيّ طريق ستختار، يا معلّم سول؟"
 },
