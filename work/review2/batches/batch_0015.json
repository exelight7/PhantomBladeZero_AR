  "key": "QuestStory_01_1",
  "text": "عكس التيار"
 },
 {
  "key": "QuestStory_SubTitle_01_1",
  "text": "من يسير عكس التيار لا يبحث أبدًا عن طريق للعودة"
 },
 {
  "key": "QuestStoryDes_01_01",
  "text": "اتباع المسار باتجاه المنبع"
 },
 {
  "key": "QuestStoryDes_01_02",
  "text": "العثور على الشلال العظيم"
 },
 {
  "key": "QuestStoryDes_01_11",
  "text": "مواصلة البحث عن الشلال العظيم"
 },
 {
  "key": "QuestStoryDes_01_S1",
  "text": "إبلاغ الحارس عند الجدار المتهدّم"
 },
 {
  "key": "QuestStoryDes_01_S2",
  "text": "دخول الخان الذي يسيطر عليه الميثاق"
 },
 {
  "key": "QuestStoryDes_01_S3",
  "text": "تحطيم حاجز السلسلة بالفأس المروّع ومواصلة التقدّم"
 },
 {
  "key": "QuestStory_01_4",
  "text": "الفولاذ والبخار"
 },
 {
  "key": "QuestStory_SubTitle_01_4",
  "text": "يسقط ستار من حديد، فيحجب ظله الشمس"
 },
 {
  "key": "QuestStoryDes_01_13",
  "text": "دخول برج الفولاذ والعثور على مخبأ المطارد"
 },
 {
  "key": "QuestStoryDes_01_14",
  "text": "تصفية الحساب مع المطارد!"
 },
 {
  "key": "QuestStoryDes_01_12",
  "text": "عبور الكهف خلف الشلال"
 },
 {
  "key": "QuestMaze_012",
  "text": "في أعماق الوادي"
 },
 {
  "key": "QuestMaze_SubTitle_012",
  "text": "لا تخشَ الأخطار التي تنتظرك"
 },
 {
  "key": "QuestStoryDes_01_S4",
  "text": "البحث عن المفتاح المفقود في أعلى برج الفولاذ"
 },
 {
  "key": "QuestStoryDes_01_S5",
  "text": "فتح البوابة الخارجية عند قاعدة البرج"
 },
 {
  "key": "QuestStory_01_2",
  "text": "كمين في الغابة"
 },
 {
  "key": "QuestStory_SubTitle_01_2",
  "text": "حين تصمت الزيزان، يكون النصل عند عنقك"
 },
 {
  "key": "QuestStoryDes_01_03",
  "text": "اتباع الطريق الرئيسي عبر الغابة إلى بانغتشن"
 },
 {
  "key": "QuestStoryDes_01_04",
  "text": "العثور على طريق آخر إلى بانغتشن"
 },
 {
  "key": "QuestStoryDes_01_05",
  "text": "عبور الغابة القرمزية وبلوغ قرية لو"
 },
 {
  "key": "QuestStory_01_3",
  "text": "بقايا بلا قلب"
 },
 {
  "key": "QuestStory_SubTitle_01_3",
  "text": "عديمو القلب لا يموتون، وأصحاب القلوب لا يعيشون"
 },
 {
  "key": "QuestStoryDes_01_06",
  "text": "العثور على نفق المهرّب في قرية لو"
 },
 {
  "key": "QuestStoryDes_01_07_0",
  "text": "العثور على جثامين الأساتذة الثلاثة ومواراتهم الثرى"
 },
 {
  "key": "QuestStoryDes_01_10",
  "text": "دخول البئر"
 },
 {
  "key": "QuestStoryDes_01_07",
  "text": "استخدام المصعد"
 },
 {
  "key": "QuestStoryDes_01_08",
  "text": "استخدام العين لفتح الدمية رقم 44"
 },
 {
  "key": "QuestStoryDes_01_09",
  "text": "دخول بانغتشن"
 },
 {
  "key": "QuestStory_02_1",
  "text": "بلدة الموت"
 },
 {
  "key": "QuestStory_SubTitle_02_1",
  "text": "غسق الأبواب التي لا جواب لها"
 },
 {
  "key": "QuestStoryDes_02_05",
  "text": "دخول المنطقة المركزية في بانغتشن"
 },
 {
  "key": "QuestStoryDes_02_10",
  "text": "العثور على طريق إلى الحي الخلفي"
 },
 {
  "key": "QuestStoryDes_04_2",
  "text": "دخول الحانة تحت الأرض التابعة للتنظيم"
 },
 {
  "key": "QuestStoryDes_04_3",
  "text": "عبور ممر الحانة إلى الحي الخلفي"
 },
 {
  "key": "QuestStory_02_2",
  "text": "درب القلب"
 },
 {
  "key": "QuestStory_02_2_SubTitle_02_1",
  "text": "مصباح وحيد في بلدة صامتة"
 },
 {
  "key": "QuestStoryDes_02_02",
  "text": "زيارة منزل يوأر في الأزقة الخلفية لبانغتشن"
 },
 {
  "key": "QuestStoryDes_04_6",
  "text": "فتح بوابة قاعة رقصة الأسد"
 },
 {
  "key": "QuestStoryDes_04_7",
  "text": "التوغّل في قاعة رقصة الأسد والعثور على المعلّم الأكبر لرقصة الأسد"
 },
 {
  "key": "QuestStoryDes_02_06",
  "text": "زيارة لي دانغ في قاعة جينغيانغ"
 },
 {
  "key": "QuestStoryDes_02_S4",
  "text": "طلب إصلاح اللِّبدة المشتعلة من لي دانغ"
 },
 {
  "key": "QuestStoryDes_04_10",
  "text": "دخول ضيعة السراب عبر الممر الخفي في دار الثعبان الخضراء"
 },
 {
  "key": "QuestStoryDes_02_03",
  "text": "العثور على سبيل لدخول ضيعة السراب"
 },
 {
  "key": "QuestStory_02_3",
  "text": "بيوت الثعبان الأربعة"
 },
 {
  "key": "QuestStory_SubTitle_02_3",
  "text": "أخضر وأحمر وأسود وأبيض، ولكلٍّ علاج سرّي"
 },
 {
  "key": "QuestStoryDes_04_4",
  "text": "مواصلة البحث عن «القلب» في الحي الخلفي"
 },
 {
  "key": "QuestStoryDes_02_S3",
  "text": "البحث في دار الثعبان الخضراء عن أدلة تقود إلى بيوت الثعبان الأخرى"
 },
 {
  "key": "QuestStoryDes_02_04",
  "text": "العثور على عين الثعبان ولسانها ونابها"
 },
 {
  "key": "QuestStoryDes_04_9",
  "text": "تفعيل آلية الثعبان داخل دار الثعبان الخضراء"
 },
 {
  "key": "QuestStoryDes_02_01",
  "text": "العثور على سلاح قادر على إحراق الشجيرات الشائكة"
 },
 {
  "key": "QuestStoryDes_02_0S4",
  "text": "استخدام شارة لونغ لفتح دار الثعبان البيضاء"
 },
 {
  "key": "QuestStory_03_3",
  "text": "الطريق إلى الأمام"
 },
 {
  "key": "QuestStory_SubTitle_03_3",
  "text": "كثيرًا ما يكون طريق النجاة طريقًا مسدودًا"
 },
 {
  "key": "QuestStoryDes_03_06",
  "text": "دخول ضيعة السراب"
 },
 {
  "key": "QuestStoryDes_11_2",
  "text": "البحث عن الوعاء المثالي حيث يرقد القلب المشعّ"
 },
 {
  "key": "QuestStoryDes_11_3",
  "text": "السفر إلى جبل تمزيق الأرواح"
 }
