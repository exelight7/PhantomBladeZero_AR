[
 {
  "key": "UI_Setting_66",
  "text": "جودة الظلال"
 },
 {
  "key": "UI_Setting_67",
  "text": "ضبط مستوى تفاصيل الظلال. توفّر الإعدادات الأعلى ظلالًا أدق وحوافًا أكثر نعومة."
 },
 {
  "key": "UI_Setting_68",
  "text": "تطبيق التغييرات"
 },
 {
  "key": "UI_Setting_69",
  "text": "تطبيق التغييرات على الإعدادات؟"
 },
 {
  "key": "UI_Setting_70",
  "text": "قد يؤدي ذلك إلى خفض الأداء بدرجة كبيرة؛ لذا يُنصح بالحذر عند الضبط."
 },
 {
  "key": "UI_Setting_71",
  "text": "جودة الخامات"
 },
 {
  "key": "UI_Setting_72",
  "text": "ضبط جودة الخامات، ما يؤثر في مستوى تفاصيل العناصر والمباني والشخصيات."
 },
 {
