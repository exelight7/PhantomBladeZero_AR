 {
  "key": "UI_Setting_102",
  "text": "جودة الدقّة الفائقة"
 },
 {
  "key": "UI_Setting_103",
  "text": "تفعيل توليد الإطارات أو تعطيله. قد يؤدي ذلك إلى زيادة معدل الإطارات بدرجة كبيرة.\n\nلتفعيل توليد الإطارات بتقنية DLSS، الانتقال إلى إعدادات ويندوز: النظام > العرض > الرسومات > تغيير إعدادات الرسومات الافتراضية، ثم تفعيل جدولة معالج الرسوميات المسرَّع عتاديًّا وإعادة تشغيل الحاسوب."
 },
 {
  "key": "UI_Setting_104",
  "text": "تلقائي"
 },
 {
  "key": "UI_Setting_105",
  "text": "حدّة الدقّة الفائقة"
 },
 {
  "key": "UI_Setting_106",
  "text": "ضبط حدّة الصورة عند تفعيل الدقّة الفائقة.\nتؤدي القيم الأعلى إلى صورة أشد حدّة، بينما تجعلها القيم الأقل أكثر نعومة.\nلا يمكن تغيير هذا الإعداد إلا عند استخدام FSR."
 },
