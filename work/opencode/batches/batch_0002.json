 {
  "key": "Appearance_Des_1",
  "text": "لباس سفر خفيف، مهترئ وممزق إثر مبارزة هزّت السماء والأرض ولم يشهدها أحد. ومع ذلك، ما زال ينسجم مع حركة قدمي سول."
 },
 {
  "key": "Appearance_Des_2",
  "text": "لباس سفر خفيف يوازن بين الحماية وحرية الحركة. وعند إطلاق الخطوة الشبحية، يندفع خيط قرمزي داكن مع كل حركة، فيشوّش نظر العدو حتى يلتبس عليه القماش والنصل فيبدوان كأنهما شيء واحد."
 },
 {
  "key": "Appearance_Des_3",
  "text": "لعل حكاية هذا المبارز الجوّال ستظل تُروى في أرجاء عالم القتال بعد أعوام كثيرة. لا أحد في هذا العالم يضاهي طيفه أو يصدّ نصله."
 },
 {
  "key": "Appearance_Des_4",
  "text": "يغلي شا-تشي مع الدم في عروقه ويندفع عبر درع الحرب، فيكسبه لونًا قرمزيًا غريبًا وعميقًا."
 },
 {
  "key": "Appearance_Des_5",
  "text": "زيّ صيّاد فضفاض بقلنسوة ثقيلة بما يكفي لصدّ الريح أثناء الركض بأقصى سرعة. لا شيء ينتزع حياة سول بسهولة. لا شيء سوى الزمن."
 },
 {
  "key": "Appearance_Des_6",
  "text": "لا درع، بل رباطة جأش معلّم أكبر. القوة، وسلالة الدم، والأصل... كل شكّ راود ذهنه في ساعات السكون وجد أخيرًا جوابًا."
 },
 {
  "key": "Appearance_Des_7",
  "text": "زيّ قتالي مهيب تعلوه دروع من الحراشف، مثالي للصمود في معركة طويلة ضارية. لعلهم يلتقون مجددًا قريبًا. بعض الشراب ووجبة بسيطة."
 },
 {
  "key": "Appearance_Des_8",
  "text": "زيّ سفر لمحارب تشبّع منذ زمن بعيد بالريح والثلج. وفي جيبه مطوية صورة فتى صغير، وترتبط بها هوسة أب لا تلين."
 },
