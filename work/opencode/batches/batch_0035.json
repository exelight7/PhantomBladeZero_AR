[
 {
  "key": "PhantomEdges_FunctionDes_019_Base",
  "text": "الضغط المتكرر على <InputAction id=\"ShaChiAttack\" height=\"26\" RightPadding=\"5\" LeftPadding=\"5\"/> لتنفيذ ما يصل إلى <dtv id=\"X331\"/> ضربات من <Character_Yellow_Decorator2>[فن رمح الرعد]</>. يستهلك إكمال السلسلة <dtv id=\"X332\"/> <img id=\"SpiritShadow\" width=\"40\"/>. تُلحق الهجمات <Character_Yellow_Decorator2>شللًا</> وتطلق البرق."
 },
 {
  "key": "PhantomEdges_FunctionDes_019_Re",
  "text": "عند إصابة رمح الرعد عدوًا، يتسلسل البرق إلى عدوّين قريبين كحد أقصى."
 },
 {
  "key": "PhantomEdges_FunctionDes_020_Advance",
  "text": "عندما يصبح الإجهاز على العدو ممكنًا، الضغط على <InputAction id=\"ShaChiAttack\" height=\"26\" RightPadding=\"5\" LeftPadding=\"5\"/> لتنفيذ إجهاز عن بُعد."
 },
 {
  "key": "PhantomEdges_FunctionDes_020_Base",
  "text": "الضغط المتكرر على <InputAction id=\"ShaChiAttack\" height=\"26\" RightPadding=\"5\" LeftPadding=\"5\"/> لتنفيذ ما يصل إلى <dtv id=\"X421\"/> هجمات إجهاز متوسطة المدى. يستهلك إكمال السلسلة <dtv id=\"X422\"/> <img id=\"SpiritShadow\" width=\"40\"/>"
 },
 {
  "key": "PhantomEdges_FunctionDes_020_Re",
  "text": "<InputAction id=\"Stance\" height=\"26\" RightPadding=\"5\" LeftPadding=\"0\"/>+<InputAction id=\"ShaChiAttack\" height=\"26\" RightPadding=\"5\" LeftPadding=\"5\"/> استهلاك <dtv id=\"X424\"/><img id=\"SpiritShadow\" width=\"40\"/>. تأرجح عجلة المنشار الدوارة عالية السرعة إلى الأمام لتمزيق الأعداء."
 },
 {
  "key": "PhantomEdges_FunctionDes_020_Terrian",
  "text": "إتاحة تشغيل المقصلة الطائرة لآليات هوانغشينغ المخصّصة،<Character_Yellow_Decorator2> حتى عند عدم تجهيزها</>."
 },
 {
  "key": "PhantomEdges_FunctionDes_022_Base",
  "text": "الضغط مطولًا على <InputAction id=\"ShaChiAttack\" height=\"26\" RightPadding=\"5\" LeftPadding=\"5\"/> لاستدعاء عربة الحرب و<Character_Yellow_Decorator2>قيادتها إلى الأمام</>، ودهس الأعداء في مسارها. ويمكن <Character_Yellow_Decorator2>توجيهها</> أثناء الاندفاع. الاستهلاك المستمر لـ <img id=\"SpiritShadow\" width=\"40\"/>"
 },
 {
  "key": "PhantomEdges_FunctionDes_022_Re",
  "text": "زيادة الضرر المُلحَق بحسب المسافة التي تقطعها عربة الحرب، حتى 50%. تُصفّر المسافة المقطوعة بعد إصابة عدو."
 },
 {
  "key": "PhantomEdges_FunctionDes_023_Base",
  "text": "الضغط على <InputAction id=\"ShaChiAttack\" height=\"26\" RightPadding=\"5\" LeftPadding=\"5\"/> لإنشاء <Character_Yellow_Decorator2>حقل</> حول الشخصية يستمر <dtv id=\"X431\"/> ثانية. وأثناء الوجود داخل الحقل، تستعيد <Character_Yellow_Decorator2>الصحة</> و<Character_Yellow_Decorator2>شا-تشي</> تدريجيًا. يستهلك <dtv id=\"X432\"/> <img id=\"SpiritShadow\" width=\"40\"/>"
 },
 {
  "key": "PhantomEdges_FunctionDes_023_Re",
  "text": "الإحياء مرة واحدة واستعادة <dtv id=\"X433\"/> من الصحة عند تلقّي ضرر قاتل داخل الحقل. لا يمكن تفعيل هذا الأثر مجددًا حتى لمس جرس أو إعادة الظهور. إذا توفرت آثار إحياء أخرى في الوقت نفسه، فتُفعّل تلك الآثار أولًا."
 },
 {
  "key": "PhantomEdges_FunctionDes_024_Advance",
  "text": "<Character_Yellow_Decorator2>الأنصال الصوتية الزرقاء </>تلحق الضرر وتسبب استنزاف شا-تشي. لا يمكن صدها.\n<Character_Yellow_Decorator2>الأنصال الصوتية الحمراء</> تلحق ضررًا أكبر. لا يمكن صدها وتتجاهل كل خفض للضرر."
 },
 {
  "key": "PhantomEdges_FunctionDes_024_Base",
  "text": "الضغط المتكرر على <InputAction id=\"ShaChiAttack\" height=\"26\" RightPadding=\"5\" LeftPadding=\"5\"/> لإطلاق <dtv id=\"X251\"/> <Character_Yellow_Decorator2>الأنصال الصوتية الزرقاء</> و<dtv id=\"X252\"/> <Character_Yellow_Decorator2>الأنصال الصوتية الحمراء</>. يستهلك إكمال السلسلة <dtv id=\"X253\"/> <img id=\"SpiritShadow\" width=\"40\"/>"
 },
 {
  "key": "PhantomEdges_FunctionDes_024_Re",
  "text": "بيبا الوتر الوهمية بعد إعادة تشكيلها <Character_Yellow_Decorator2>البيبا الوهمية</>. منح القدرة على تبديد الحواجز الطيفية والسيطرة على الأعداء الأضعف."
 },
 {
  "key": "PhantomEdges_FunctionDes_025_Base",
  "text": "في المناطق الكثيفة بشا-تشي (عندما ينبعث من الأيقونة توهج خاص)، الضغط على <InputAction id=\"ShaChiAttack\" height=\"26\" RightPadding=\"5\" LeftPadding=\"0\"/> لاستدعاء <dtv id=\"X231\"/> <Character_Yellow_Decorator2>دمية السيف والدرع</> و<dtv id=\"X232\"/> <Character_Yellow_Decorator2>دمية الرمح والدرع</>. تقاتلان لمدة تصل إلى <dtv id=\"X233\"/> ثانية ويُنهى استدعاؤهما قبل ذلك عند هزيمتهما. لا يمكن تكديس الاستدعاءات. ويحل الاستدعاء مجددًا محل أي استدعاءات قائمة. يستهلك <dtv id=\"X234\"/> <img id=\"SpiritShadow\" width=\"40\"/>"
 },
 {
  "key": "PhantomEdges_FunctionDes_025_Re",
  "text": "تحويله إلى <Character_Yellow_Decorator2>جرس الهاوية</> بصقل الروح، ما يتيح استدعاء دمية قوية إضافية، هي الدمية رقم <dtv id=\"X235\"/>."
 },
 {
  "key": "PhantomEdges_FunctionDes_026_Base",
  "text": "في المناطق التي يكثر فيها شا-تشي (عندما يصدر الرمز وهجًا خاصًا)، الضغط على <InputAction id=\"ShaChiAttack\" height=\"26\" RightPadding=\"5\" LeftPadding=\"5\"/> لاستدعاء <dtv id=\"X381\"/><Character_Yellow_Decorator2> قائد المبارزين </> و<dtv id=\"X382\"/><Character_Yellow_Decorator2> تلميذ مبارز</>. يقاتلون لمدة تصل إلى <dtv id=\"X383\"/> ثانية ويختفون مبكرًا عند هزيمتهم. لا يمكن تكديس الاستدعاءات. يؤدي الاستدعاء مجددًا إلى استبدال أي استدعاءات قائمة. استهلاك <dtv id=\"X384\"/> <img id=\"SpiritShadow\" width=\"40\"/>"
 },
 {
  "key": "PhantomEdges_FunctionDes_026_Re",
  "text": "استبدال <Character_Yellow_Decorator2>قائد المبارزين</> المستدعى بـ<Character_Yellow_Decorator2>مبارز النصلين ذو الرداء الأرجواني</>، واستبدال تلميذي المبارزين المستدعيين بـ<Character_Yellow_Decorator2>حماة سيف بايشان</>. ترث الاستدعاءات الجديدة جميع ترقيات المبارزين."
 },
 {
  "key": "PhantomEdges_FunctionDes_109_Base",
  "text": "الضغط مطولًا على <InputAction id=\"ShaChiAttack\" height=\"26\" RightPadding=\"5\" LeftPadding=\"5\"/> لـ<Character_Yellow_Decorator2>شحن</> سهم أثناء التحرك. ثم إفلات <InputAction id=\"ShaChiAttack\" height=\"26\" RightPadding=\"5\" LeftPadding=\"5\"/> لإطلاقه. يستهلك <dtv id=\"X471\"/> <img id=\"SpiritShadow\" width=\"40\"/>. إلحاق ضرر أكبر بالأعداء ذوي الصحة الكاملة."
 },
 {
  "key": "PhantomEdges_FunctionDes_109_Re",
  "text": "الضغط المطوّل على <InputAction id=\"ShaChiAttack\" height=\"26\" RightPadding=\"5\" LeftPadding=\"5\"/> لل<Character_Yellow_Decorator2>شدّ القوس وشحنه</>. الشحن حتى <dtv id=\"X473\"/> مراحل، مع إضافة سهم لكل مرحلة. استهلاك <dtv id=\"X474\"/> <img id=\"SpiritShadow\" width=\"40\"/>."
 },
 {
  "key": "PhantomEdges_FunctionDes_109_Terrian",
  "text": "إمكانية إسقاط بعض الأجسام المعلّقة بإطلاق النار من مدى متوسط إلى بعيد بعد الحصول عليها، <Character_Yellow_Decorator2>حتى عند عدم التجهيز.</>"
 },
 {
  "key": "PhantomEdges_FunctionDes_124_Base",
  "text": "الضغط المتكرر على <InputAction id=\"ShaChiAttack\" height=\"26\" RightPadding=\"5\" LeftPadding=\"5\"/> لإطلاق <dtv id=\"X261\"/> <Character_Yellow_Decorator2>الأنصال الصوتية الزرقاء</> و<dtv id=\"X262\"/> <Character_Yellow_Decorator2>الأنصال الصوتية الحمراء</>. يستهلك إكمال السلسلة <dtv id=\"X263\"/> <img id=\"SpiritShadow\" width=\"40\"/>"
 },
 {
  "key": "PhantomEdges_FunctionDes_124_EX",
  "text": "إذا أصاب <Character_Yellow_Decorator2>نصل صوتي أحمر</> عدوًا <Character_Yellow_Decorator2>مكسور الدفاع</>، سيُسيطر عليه ويجعله يهاجم الأعداء الآخرين. <Character_Yellow_Decorator2>لا تأثير له على الأعداء الأقوياء</>."
 },
 {
  "key": "PhantomEdges_FunctionDes_124_Terrian",
  "text": "بعد الحصول عليها، إمكانية استخدام البيبا الوهمية لتبديد الضباب الذي يحجب الحواجز الطيفية، <Character_Yellow_Decorator2>حتى عند عدم تجهيزها</>."
 },
 {
  "key": "PhantomEdges_FunctionDes_125_Advance",
  "text": "بالإضافة إلى استدعاء الدمية <dtv id=\"X245\"/>، المختارة عشوائيًا من بين <Character_Yellow_Decorator2>دمية مدفع السبيكة</>، و<Character_Yellow_Decorator2>دمية الاغتيال الذهبية</>، أو <Character_Yellow_Decorator2>دمية المظلّة الحديدية</>، بقدراتها القتالية كاملة."
 },
 {
  "key": "PhantomEdges_FunctionDes_125_Base",
  "text": "في المناطق الكثيفة بشا-تشي (عندما ينبعث من الأيقونة توهج خاص)، الضغط على <InputAction id=\"ShaChiAttack\" height=\"26\" RightPadding=\"5\" LeftPadding=\"0\"/> لاستدعاء <dtv id=\"X241\"/> <Character_Yellow_Decorator2>دمية السيف والدرع</> و<dtv id=\"X242\"/> <Character_Yellow_Decorator2>دمية الرمح والدرع</>. تقاتلان لمدة تصل إلى <dtv id=\"X243\"/> ثانية ويُنهى استدعاؤهما قبل ذلك عند هزيمتهما. لا يمكن تكديس الاستدعاءات. ويحل الاستدعاء مجددًا محل أي استدعاءات قائمة. يستهلك <dtv id=\"X244\"/> <img id=\"SpiritShadow\" width=\"40\"/>"
 },
